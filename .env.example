HF_TOKEN=hf_your_new_token_here
HF_MODEL=Qwen/Qwen2.5-7B-Instruct-1M

# Optional
# KAIROS_STORAGE=mongodb
# KAIROS_MONGODB_URI=mongodb+srv://...
# KAIROS_MONGODB_DATABASE=kairos
# KAIROS_MONGODB_COLLECTION=state
# KAIROS_SEARXNG_URL=http://127.0.0.1:8080

# MongoDB notes:
# - Keep real credentials in .env only. Do not commit them.
# - Kairos uses one collection as a state bucket with documents such as
#   _id=goals, _id=sessions, _id=current_season, and _id=brain_memories.
